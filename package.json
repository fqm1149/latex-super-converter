{
  "name": "latex-super-converter",
  "version": "1.2.0",
  "description": "Convert and repair LaTeX delimiters, auto-detect bare formulas, and preserve Markdown structure.",
  "main": "main.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --external:obsidian --format=cjs --platform=node --target=es2018 --outfile=main.js",
    "dev": "npm run build -- --watch",
    "test": "node test/converter.test.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "latex",
    "mathjax"
  ],
  "author": "YG",
  "license": "MIT",
  "devDependencies": {}
}
